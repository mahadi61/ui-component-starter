{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      // "@/*": ["src/*"],
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
